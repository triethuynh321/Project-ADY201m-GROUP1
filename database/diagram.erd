    "ddlScripts": {
      "before": "\n-- Xóa toàn bộ các bảng cũ nếu tồn tại để làm sạch\nDROP TABLE IF EXISTS \n    restaurant_stats, \n    review_length_stats, \n    reviews_1_star, \n    reviews_north, \n    reviews_central, \n    reviews_south, \n    restaurants \nCASCADE;\n\n-- 1. BẢNG GỐC: restaurants\nCREATE TABLE restaurants (\n    restaurant_id VARCHAR(100),\n    name VARCHAR(255),\n    city VARCHAR(100),\n    total_reviews INT DEFAULT 0,\n    avg_rating FLOAT DEFAULT 0.0,\n    avg_comment_length FLOAT DEFAULT 0.0\n);\n\n-- 2. BẢNG THỐNG KÊ ĐÁNH GIÁ: restaurant_stats (Không có khóa ngoại gắt gao)\nCREATE TABLE restaurant_stats (\n    restaurant_id VARCHAR(100),\n    name VARCHAR(255),\n    total_reviews INT NOT NULL,\n    avg_rating FLOAT NOT NULL\n);\n\n-- 3. BẢNG THỐNG KÊ ĐỘ DÀI: review_length_stats\nCREATE TABLE review_length_stats (\n    restaurant_id VARCHAR(100),\n    name VARCHAR(255),\n    total_comments INT NOT NULL,\n    avg_comment_length FLOAT NOT NULL\n);\n\n-- 4. BẢNG ĐÁNH GIÁ 1 SAO: reviews_1_star\nCREATE TABLE reviews_1_star (\n    restaurant_id VARCHAR(100),\n    name VARCHAR(255),\n    city VARCHAR(100),\n    author_name VARCHAR(255),\n    rating INT,\n    comment_cleaned TEXT,\n    comment_length INT,\n    platform VARCHAR(50)\n);\n\n-- 5. BẢNG VÙNG MIỀN BẮC: reviews_north\nCREATE TABLE reviews_north (\n    restaurant_id VARCHAR(100),\n    name VARCHAR(255),\n    city VARCHAR(100),\n    author_name VARCHAR(255),\n    rating INT,\n    comment_cleaned TEXT,\n    comment_length INT,\n    platform VARCHAR(50)\n);\n\n-- 6. BẢNG VÙNG MIỀN TRUNG: reviews_central\nCREATE TABLE reviews_central (\n    restaurant_id VARCHAR(100),\n    name VARCHAR(255),\n    city VARCHAR(100),\n    author_name VARCHAR(255),\n    rating INT,\n    comment_cleaned TEXT,\n    comment_length INT,\n    platform VARCHAR(50)\n);\n\n-- 7. BẢNG VÙNG MIỀN NAM: reviews_south\nCREATE TABLE reviews_south (\n    restaurant_id VARCHAR(100),\n    name VARCHAR(255),\n    city VARCHAR(100),\n    author_name VARCHAR(255),\n    rating INT,\n    comment_cleaned TEXT,\n    comment_length INT,\n    platform VARCHAR(50)\n);\n\n-- TẠO CÁC INDEX TỐI ƯU HÓA TRUY VẤN\nCREATE INDEX idx_restaurants_city ON restaurants(city);\nCREATE INDEX idx_restaurants_id ON restaurants(restaurant_id);\nCREATE INDEX idx_north_city ON reviews_north(city);\nCREATE INDEX idx_central_city ON reviews_central(city);\nCREATE INDEX idx_south_city ON reviews_south(city);\nCREATE INDEX idx_1star_rating ON reviews_1_star(rating);",
      "after": ""
    }
  },
